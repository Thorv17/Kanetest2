<% content_for :title, "Quotes — ThoughtVault" %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h2>&#128221; <%= admin_user? ? "All Public Quotes" : "My Quotes" %></h2>
  <% unless admin_user? %>
    <%= link_to "&#43; Add Quote".html_safe, new_quote_path, class: "btn btn-success" %>
  <% end %>
</div>

<% if @quotes.empty? %>
  <p class="text-muted">No quotes found.</p>
<% else %>
  <div id="quotes">
    <% @quotes.each do |quote| %>
      <article class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <%= render quote %>
          <div class="mt-2 d-flex gap-2">
            <%= link_to "Full Details", quote_path(quote), class: "btn btn-sm btn-outline-success" %>
            <% if !admin_user? && quote.user_id == current_user.id %>
              <%= link_to "Edit", edit_quote_path(quote), class: "btn btn-sm btn-outline-secondary" %>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
<% end %>
