<%# Shared form partial for creating and editing quotes %>

<%# Display validation errors if any %>
<% if @quote.errors.any? %>
  <div class="alert alert-danger">
    <strong>Please correct the following:</strong>
    <ul class="mb-0 mt-1">
      <% @quote.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with(model: @quote, local: true) do |f| %>
  <%# Store the current user's ID — hidden from display %>
  <%= f.hidden_field :user_id, value: current_user.id %>

  <div class="mb-3">
    <label class="form-label fw-semibold">Quote Text <span class="text-danger">*</span></label>
    <%= f.text_area :content, class: "form-control", rows: 4,
        placeholder: "Enter the quote text here..." %>
  </div>

  <div class="mb-3">
    <label class="form-label fw-semibold">Publication Year</label>
    <%= f.text_field :pub_year, class: "form-control",
        placeholder: "e.g. 1869, 400 BCE (optional)" %>
  </div>

  <div class="mb-3">
    <label class="form-label fw-semibold">Your Note / Comment</label>
    <%= f.text_area :note, class: "form-control", rows: 2,
        placeholder: "Add a personal note about this quote (optional)" %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :is_public, class: "form-check-input" %>
    <%= f.label :is_public, "Make this quote publicly visible", class: "form-check-label" %>
  </div>

  <%# Author (thinker) selector — different labelling from friend's Philosopher %>
  <div class="mb-3">
    <label class="form-label fw-semibold">Thinker / Author <span class="text-danger">*</span></label>
    <%= f.select :author_id,
        Author.order(:lname, :fname).collect { |a| ["#{a.fname} #{a.lname}", a.id] },
        { include_blank: "— select a thinker —" },
        class: "form-select" %>
    <div class="form-text">
      Not listed? <%= link_to "Add a new thinker", new_author_path, target: "_blank" %>
    </div>
  </div>

  <%# Category tag slots — always 4 rows, using quote_categories (vs friend's quote_categories) %>
  <label class="form-label fw-semibold">Categories <span class="text-danger">*</span></label>
  <div id="category-slots">
    <% @quote.quote_categories.each do |tag| %>
      <%= f.fields_for :quote_categories, tag do |tf| %>
        <div class="category-slot row mb-2">
          <div class="col-auto">
            <%= tf.select :category_id,
                Category.order(:name).collect { |c| [c.name, c.id] },
                { include_blank: true },
                class: "form-select d-inline-block w-auto",
                style: "min-width: 200px" %>
            <%= tf.hidden_field :_destroy, class: "destroy-flag", value: "0" %>
          </div>
          <div class="col-auto align-self-center">
            <%= link_to "Remove", "#", class: "remove-slot text-danger small text-decoration-none" %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="mt-3">
    <%= f.submit local_assigns[:btn_label] || "Save Quote",
        class: "btn btn-success btn-lg" %>
  </div>
<% end %>

<%# JavaScript for dynamically removing category slots — same concept, different variable names %>
<script>
function attachRemoveHandlers() {
  document.querySelectorAll(".remove-slot").forEach(function(link) {
    link.addEventListener("click", function(e) {
      e.preventDefault();
      const allSlots = document.querySelectorAll(".category-slot:not([style*='display: none'])");
      if (allSlots.length <= 1) return; // Always keep at least one slot
      const slot = this.closest(".category-slot");
      const flag = slot.querySelector(".destroy-flag");
      if (flag) flag.value = "1";
      slot.style.display = "none";
    });
  });
}
document.addEventListener("DOMContentLoaded", attachRemoveHandlers);
document.addEventListener("turbo:load", attachRemoveHandlers);
</script>
