<% content_for :title, "Edit Quote — MyQuote" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>&#9998; Edit Quote</h2>
  <%= link_to "&larr; Cancel".html_safe, quote_path(@quote), class: "btn btn-outline-secondary btn-sm" %>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body p-4">
    <%= render "form", quote: @quote, btn_label: "Update Quote" %>
  </div>
</div>
