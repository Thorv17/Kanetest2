<% content_for :title, "Create Account — ThoughtVault" %>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm border-0 mt-3">
      <div class="card-header bg-success text-white text-center py-3">
        <h4 class="mb-0">&#128221; Join ThoughtVault — It&rsquo;s Free</h4>
      </div>
      <div class="card-body p-4">
        <%= render "form", user: @user, submit_label: "Create My Account" %>
        <hr>
        <p class="text-center text-muted mb-0">
          Already a member? <%= link_to "Sign in here", login_path, class: "text-success fw-semibold" %>
        </p>
      </div>
    </div>
  </div>
</div>
