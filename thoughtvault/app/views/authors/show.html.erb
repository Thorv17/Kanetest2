<% content_for :title, "#{@author.fname} #{@author.lname} — MyQuote" %>

<div class="card border-0 shadow-sm mt-3" style="max-width:600px;">
  <div class="card-header bg-success text-white py-3">
    <h4 class="mb-0">&#128218; Thinker Profile</h4>
  </div>
  <div class="card-body p-4">
    <%= render @author %>
    <hr>
    <div class="d-flex gap-2">
      <%= link_to "Edit", edit_author_path(@author), class: "btn btn-outline-secondary" %>
      <%= button_to "Delete", @author, method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Remove this thinker? Associated quotes will not be deleted." } %>
      <%= link_to "All Thinkers", authors_path, class: "btn btn-outline-success" %>
    </div>
  </div>
</div>
