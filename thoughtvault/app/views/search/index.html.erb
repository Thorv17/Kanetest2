<% content_for :title, "Search — MyQuote" %>

<h2 class="mb-3">&#128270; Search Quotes</h2>
<p class="text-muted">Search by category name, thinker first name, or last name.</p>

<%# Search form — supports category AND author name (different from friend who only did category) %>
<%= form_tag search_path, method: :get do %>
  <div class="input-group mb-3" style="max-width: 500px;">
    <%= text_field_tag :query, params[:query], class: "form-control",
        placeholder: "e.g. Ethics, Kant, Aristotle..." %>
    <%= submit_tag "Search", class: "btn btn-success" %>
  </div>
<% end %>

<% if params[:query].present? %>
  <% if @results.present? %>
    <div class="alert alert-success">
      Found <strong><%= pluralize(@results.count, "quote") %></strong>
      matching &ldquo;<%= params[:query] %>&rdquo;
    </div>

    <% @results.each do |quote| %>
      <article class="card border-0 shadow-sm mb-3">
        <div class="card-body">
          <blockquote class="blockquote mb-1">
            <p class="fst-italic">&ldquo;<%= quote.content %>&rdquo;</p>
            <footer class="blockquote-footer">
              <% if quote.author.present? %>
                <%= quote.author.fname %> <%= quote.author.lname %>
              <% else %>
                Unknown Author
              <% end %>
            </footer>
          </blockquote>
          <div class="mt-2">
            <%# Show category tags as badges %>
            <% quote.categories.each do |cat| %>
              <span class="badge bg-success-subtle text-success border border-success me-1"><%= cat.name %></span>
            <% end %>
          </div>
          <div class="mt-2">
            <%= link_to "Full Details &rarr;".html_safe, quote_path(quote),
                class: "btn btn-sm btn-outline-success" %>
          </div>
        </div>
      </article>
    <% end %>
  <% else %>
    <div class="alert alert-warning">
      No public quotes found for &ldquo;<%= params[:query] %>&rdquo;. Try a different term.
    </div>
  <% end %>
<% end %>
