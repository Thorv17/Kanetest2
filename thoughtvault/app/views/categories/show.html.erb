<% content_for :title, "#{@category.name} — ThoughtVault" %>

<div class="card border-0 shadow-sm mt-3" style="max-width:400px;">
  <div class="card-header bg-warning py-3">
    <h4 class="mb-0">&#127991; Category</h4>
  </div>
  <div class="card-body p-4">
    <%= render @category %>
    <hr>
    <div class="d-flex gap-2">
      <%= link_to "Edit", edit_category_path(@category), class: "btn btn-outline-warning" %>
      <%= button_to "Delete", @category, method: :delete,
          class: "btn btn-danger",
          data: { turbo_confirm: "Delete this category?" } %>
      <%= link_to "All Categories", categories_path, class: "btn btn-outline-secondary" %>
    </div>
  </div>
</div>
