<% content_for :title, "New Category — ThoughtVault" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>&#43; New Category</h2>
  <%= link_to "&larr; Back to Categories".html_safe, categories_path, class: "btn btn-outline-secondary btn-sm" %>
</div>
<div class="card border-0 shadow-sm" style="max-width:450px;">
  <div class="card-body p-4">
    <%= render "form", category: @category, btn_label: "Create Category" %>
  </div>
</div>
