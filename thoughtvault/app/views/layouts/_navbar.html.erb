<!-- ThoughtVault navigation bar — teal/green theme, different from friend's dark theme -->
<nav class="navbar navbar-expand-lg navbar-dark bg-success shadow-sm">
  <div class="container">
    <!-- Brand logo/name links to public home page -->
    <%= link_to "&#128218; ThoughtVault".html_safe, root_path, class: "navbar-brand fw-bold" %>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#tvNav" aria-controls="tvNav"
            aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="tvNav">
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">

        <!-- Always visible: Home, Browse, About -->
        <li class="nav-item">
          <%= link_to "Home", root_path, class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "Search", search_path, class: "nav-link" %>
        </li>
        <li class="nav-item">
          <%= link_to "About", about_path, class: "nav-link" %>
        </li>

        <!-- Guest-only links -->
        <% unless logged_in? %>
          <li class="nav-item">
            <%= link_to "Sign Up", new_user_path, class: "nav-link" %>
          </li>
          <li class="nav-item">
            <%= link_to "Sign In", login_path, class: "nav-link" %>
          </li>
        <% end %>

        <!-- Sign Out (all logged-in users) -->
        <% if logged_in? %>
          <li class="nav-item">
            <%= button_to "Sign Out", logout_path, method: :delete,
                class: "btn btn-link nav-link text-white p-0 ps-3" %>
          </li>
        <% end %>

        <!-- Standard user drop-down menu -->
        <% if logged_in? && !admin_user? %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
              My Account
            </a>
            <ul class="dropdown-menu">
              <%= link_to "Dashboard", dashboard_path, class: "dropdown-item" %>
              <%= link_to "My Quotes", my_quotes_path, class: "dropdown-item" %>
              <li><hr class="dropdown-divider"></li>
              <%= link_to "Add New Quote", new_quote_path, class: "dropdown-item" %>
              <%= link_to "Thinkers", authors_path, class: "dropdown-item" %>
            </ul>
          </li>
        <% end %>

        <!-- Administrator drop-down menu -->
        <% if logged_in? && admin_user? %>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button"
               data-bs-toggle="dropdown" aria-expanded="false">
              Admin
            </a>
            <ul class="dropdown-menu">
              <%= link_to "Admin Dashboard", admin_path, class: "dropdown-item" %>
              <%= link_to "Manage Users", users_path, class: "dropdown-item" %>
              <%= link_to "Manage Categories", categories_path, class: "dropdown-item" %>
              <%= link_to "Thinkers", authors_path, class: "dropdown-item" %>
            </ul>
          </li>
        <% end %>

      </ul>

      <!-- Greeting shown when logged in -->
      <% if logged_in? %>
        <span class="navbar-text text-white-50 small">
          Hello, <%= session[:fname] %> <%= admin_user? ? "(Admin)" : "" %>
        </span>
      <% end %>
    </div>
  </div>
</nav>
